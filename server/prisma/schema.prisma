generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String               @map("password_hash")
  name          String
  avatarColor   String               @default("#3b82f6") @map("avatar_color")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  // Relations
  documentsOwned      Document[]           @relation("DocumentOwner")
  documentPermissions DocumentPermission[]
  refreshTokens       RefreshToken[]
  snapshotsCreated    DocumentSnapshot[]   @relation("SnapshotCreator")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Document {
  id             String               @id @default(uuid())
  title          String               @default("Untitled Document")
  contentPreview String?              @map("content_preview")
  ownerId        String               @map("owner_id")
  owner          User                 @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Yjs full document binary state snapshot vector
  currentState   Bytes?               @map("current_state")
  
  isPublic       Boolean              @default(false) @map("is_public")
  defaultRole    String               @default("VIEWER") @map("default_role")
  
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  // Relations
  permissions    DocumentPermission[]
  snapshots      DocumentSnapshot[]

  @@map("documents")
}

model DocumentPermission {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       String   @default("VIEWER")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, documentId])
  @@map("document_permissions")
}

model DocumentSnapshot {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Stored binary Y.Doc update vector for this snapshot point
  binaryState Bytes    @map("binary_state")
  
  title       String   @default("Saved Version")
  comment     String?
  createdById String   @map("created_by_id")
  createdBy   User     @relation("SnapshotCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([documentId, createdAt])
  @@map("document_snapshots")
}
